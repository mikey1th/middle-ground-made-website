---

const pageTitle = "About — Middle Ground Made";


import '../styles/global.css';
import Navigation from '../components/navigation.astro'
import PageWrapper from '../components/page-wrapper.astro';
import ContextSection from '../components/context-section.astro';
import ContextSectionLinks from '../components/context-section-links.astro';
import ContextSectionFooter from '../components/context-section-footer.astro';


---


<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content="Middle Ground Made" />
		<meta property="og:description" content="Heirloom design studio." />
		<meta property="og:image" content="https://middlegroundmade.com/mg-social-share.webp" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Middle Ground Made" />
		<meta name="twitter:description" content="Heirloom design studio." />
		<meta name="twitter:image" content="https://middlegroundmade.com/mg-social-share.webp" />
	</head>
	<body>
	  <PageWrapper>
	    <Navigation />
	      <ContextSection>
          <ContextSectionLinks>
            <a href="/bio/" class="primary-button">Bio</a>
            <a href="/what-why/" class ="primary-button"> What / Why </a>
            <a href="/contact/" class ="primary-button"> Contact </a>
            <a href="/cv/" class ="primary-button"> curriculum vitae </a>
          </ContextSectionLinks>
	      </ContextSection>   
    <ContextSectionFooter />
    <PageWrapper/>
    </body>
    </html>







<style>
    h1 {
      color: #2d2d2d;
      font-size: 4rem;
    }

    .links {
      color: var(--linkColor);
      font-weight: var(--linkWeight);
      text-transform: var(--linkCase);
    }



    