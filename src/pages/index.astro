---

import '../styles/global.css';
import Navigation from '../components/navigation.astro';
import PageWrapper from '../components/page-wrapper.astro';
import ContextSection from '../components/context-section.astro';
import ContextSectionFooter from '../components/context-section-footer.astro';
import HomePageContent from '../components/home-page-content.astro';

const pageTitle = "Middle Ground Made";

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:title" content="Middle Ground Made" />
		<meta property="og:description" content="Heirloom design studio." />
		<meta property="og:image" content="https://middlegroundmade.com/mg-social-share.webp" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Middle Ground Made" />
		<meta name="twitter:description" content="Heirloom design studio." />
		<meta name="twitter:image" content="https://middlegroundmade.com/mg-social-share.webp" />

</head>
	</head>
	<body>
		<PageWrapper>
		<Navigation/>	
		<ContextSection>
		<p> Welcome to the Middle Ground Made Website, here's what's on offer!</p>
		</ContextSection>

		<ContextSection>
		<HomePageContent/>
		</ContextSection>
		
		<ContextSectionFooter/>

		</PageWrapper>
	</body>
</html>


<style>

	.more-space{
	margin-top: 20px;
	margin-bottom: 20px;

	}


	
</style>