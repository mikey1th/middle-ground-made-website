---

import '../styles/global.css';
import Navigation from '../components/navigation.astro'
import ContextSectionFooter from '../components/context-section-footer.astro';
import PageWrapper from '../components/page-wrapper.astro';
import ContextSection from '../components/context-section.astro';
import ContextSectionNoPadding from '../components/context-section-no-padding.astro';
import OpenNotesVolumeOneLinks from '../components/open-notes-volume-one-links.astro';
import BackButton from '../components/back-button.astro';

const files = import.meta.glob('../pages/open-notes-archive/*.md');
const count = Object.keys(files).length;

const pageTitle = "Open Notes — Middle Ground Made"

---



<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content="Middle Ground Made" />
		<meta property="og:description" content="Heirloom design studio." />
		<meta property="og:image" content="https://middlegroundmade.com/mg-social-share.webp" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Middle Ground Made" />
		<meta name="twitter:description" content="Heirloom design studio." />
		<meta name="twitter:image" content="https://middlegroundmade.com/mg-social-share.webp" />
    </head>
    <body>
        <PageWrapper>
        <Navigation/>
            <ContextSection>
            <h2>Open Notes</h2> 
	          <hr>
            <p class="note">
            [{count}] Entries sorted by year
            </p>
            </ContextSection>

            <ContextSection>
            <OpenNotesVolumeOneLinks/>  

            <BackButton/>

            </ContextSection>

            <ContextSectionFooter/>
        </PageWrapper>
        
    </body>
<html/>





<style>


  .section-divider {
    margin: 0px 1.25rem;
    width: auto;
  }

  .margin{
    margin: 1.25rem 1.25rem;
  }



</style>

