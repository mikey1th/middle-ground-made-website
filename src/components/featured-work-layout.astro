---

import '../styles/global.css';
import { Image } from 'astro:assets';
import TwoLiners from '../assets/website-images/project-images/two-liners-01.webp';
import Lostman from '../assets/website-images/project-images/lostman.webp';


---




<div class="image-collection-div">

    <a href="/project-archive/logo-sign/" class="image-entry">    
        <Image
        src={TwoLiners}
        alt="Logo Sign painting"
        class="linked-image"
        
        loading= "eager" />              
    </a>    

    <a href="/project-archive/book-mark/" class="image-entry">    
        <Image
        src={Lostman}
        alt="Logo Sign painting"
        class="linked-image"
        loading= "eager" />              
    </a> 



</div>




<style>

a:hover{
    font-weight: 500;
}

</style>