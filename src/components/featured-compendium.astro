---

import '../styles/global.css';
import { Image } from 'astro:assets';
import Entry223 from '../assets/website-images/compendium-images/mgc-223.webp';
import Entry225 from '../assets/website-images/compendium-images/mgc-225.webp';

---




<div class="image-collection-div">


    <a href="/compendium/" class="image-entry">    
        <Image
        src={Entry225}
        alt="Logo Sign painting"
        class="linked-image"
        loading= "eager" />              
    </a>  


    <a href="/compendium/" class="image-entry">    
        <Image
        src={Entry223}
        alt="Logo Sign painting"
        class="linked-image"
        loading= "eager" />              
    </a> 


</div>




<style>

a:hover{
    font-weight: 500;
}

</style>